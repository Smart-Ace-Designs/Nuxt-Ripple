{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.classAttributes": [
    "active-class",
    "class",
    "inactive-class",
    "ui"
  ],
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.experimental.classRegex": [
    [
      "ui:\\s*{([^)]*)\\s*}",
      "(?:'|\"|`)([^']*)(?:'|\"|`)"
    ],
    [
      "bodyAttrs:\\s*{[^}]*class:\\s*['\"`]([^'\"`]*)['\"`]",
      "([^ ]*)"
    ]
  ]
}